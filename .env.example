# 1. CORE APPLICATION & CANONICAL DOMAIN
NODE_ENV="production"
PORT=3000
NEXT_PUBLIC_APP_URL="https://zxzmods.com"
NEXT_PUBLIC_SITE_URL="https://zxzmods.com"
ALLOWED_ORIGINS="https://zxzmods.com,https://www.zxzmods.com"

# 2. DATABASE CONFIGURATION (Supabase PostgreSQL vs Local SQLite)
# In Development (Local SQLite):
# DATABASE_URL="file:./dev.db"

# In Production (Supabase PostgreSQL on Vercel):
# Pooled connection string (Transaction pooler - port 6543):
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection string for Prisma migrations/db push (Session pooler / Direct - port 5432):
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# 2.1 SUPABASE STORAGE ENGINE (Direct Signed Browser-to-Cloud Uploads - Bypasses Vercel 4.5MB limits)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_STORAGE_BUCKET="zxz-mods-media"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_SECRET_KEY"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY"

# 3. CRYPTOGRAPHIC SESSION SECRETS (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# High-entropy secret for signing stealth backdoor/staff admin session cookies (min 64 hex chars)
STEALTH_SESSION_SECRET="CHANGE_ME_TO_A_64_CHAR_HEX_SECRET_FOR_STEALTH_TERMINAL"

# High-entropy secret for signing customer session cookies (min 64 hex chars)
CUSTOMER_SESSION_SECRET="CHANGE_ME_TO_A_64_CHAR_HEX_SECRET_FOR_CUSTOMER_SESSIONS"
JWT_SECRET="CHANGE_ME_TO_A_64_CHAR_HEX_SECRET_FOR_JWT"
CRON_SECRET="CHANGE_ME_TO_A_32_CHAR_HEX_SECRET_FOR_CRON"

# 4. MASTER ACCOUNT BOOTSTRAP (For initial server setup)
MASTER_EMAIL="master@zxzmods.com"
