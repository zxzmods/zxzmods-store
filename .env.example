NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="zxzmods-ac591.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="102938475610"
NEXT_PUBLIC_FIREBASE_APP_ID="1:102938475610:web:zxzmods-ac591"

# 7. FIREBASE ADMIN & GOOGLE CLOUD SERVICE ACCOUNT (Server-Side)
# Required for zero-trust server validation of MASTER, STAFF, and customer tokens.
