# ==============================================================================
# ZxZ MODS - Enterprise Security .gitignore
# Strictly prevents credentials, secrets, backups, and local state from git
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.js

# Testing & Coverage
/coverage

# Next.js build and cache output
/.next/
/out/
tsconfig.tsbuildinfo

# Production builds
/build

# Environment files and credentials (CRITICAL SECURITY)
.env
.env.*
!.env.example
*.pem
*.key
*.json-key
*service-account*.json
*gcp-key*.json
*firebase-adminsdk*.json
*credentials*.json
credentials.json
client_secret*.json

# Database Backups & Dumps (Contains customer PII and hashed secrets)
backups/
/backups/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.dump
*.sql
prisma/*.db
prisma/*.db-journal
prisma/*.db-wal
prisma/*.db-shm
scripts/data-backup.json
scripts/*backup*.json

# User Uploads & Runtime Cache Files
# Ignore customer payment receipts (PII) and oversized >50MB raw videos in Git;
# keep lightweight store catalog logos/product images (/brands, /products) for immediate Vercel rendering
/public/uploads/payments/*
!/public/uploads/payments/.gitkeep
/public/uploads/videos/*
!/public/uploads/videos/.gitkeep
/src/data/live_exchange_rate.json

# Debug & Error logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# AI Assistant & Local scratch files
.gemini/
scratch/

# IDE & OS generated files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
